<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>EME.Diagnostics.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platform>x64</Platform>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <CsWinRTEnabled>true</CsWinRTEnabled>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\EME.Diagnostics.Core\EME.Diagnostics.Core.csproj" />
    <ProjectReference Include="..\EME.Diagnostics.Hardware\EME.Diagnostics.Hardware.csproj" />
    <ProjectReference Include="..\EME.Diagnostics.Services\EME.Diagnostics.Services.csproj" />
    <ProjectReference Include="..\EME.Diagnostics.Reporting\EME.Diagnostics.Reporting.csproj" />
    <ProjectReference Include="..\EME.Diagnostics.Shared\EME.Diagnostics.Shared.csproj" />
    <ProjectReference Include="..\EME.Diagnostics.GpuEngine\EME.Diagnostics.GpuEngine.vcxproj" ReferenceOutputAssembly="false" Condition="'$(SkipGpuEngine)' != 'true'" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4948" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
  </ItemGroup>
  <ItemGroup><Manifest Include="$(ApplicationManifest)" /></ItemGroup>
  <ItemGroup>
    <Content Include="..\..\config\hardware-mapping.json" Link="config\hardware-mapping.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
